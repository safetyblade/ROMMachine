diff --git a/hw/xbox/hle/vk/cartdeck_stage_probe.h b/hw/xbox/hle/vk/cartdeck_stage_probe.h
new file mode 100644
index 0000000000..33b06d8a9f
--- /dev/null
+++ b/hw/xbox/hle/vk/cartdeck_stage_probe.h
@@ -0,0 +1,30 @@
+/* Explicit pixel-probe request only. No paths, images, or periodic logging. */
+#ifndef CARTDECK_STAGE_PROBE_H
+#define CARTDECK_STAGE_PROBE_H
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+enum CartdeckStage { CD_KERNEL_CALL, CD_FRONT_COMMAND, CD_FRONT_DRAW, CD_BACK_COMMAND,
+    CD_BACK_DRAW, CD_DISPLAY_WRITE, CD_SWAP_REJECT, CD_VK_DRAW, CD_PB_METHOD, CD_STAGE_COUNT };
+typedef struct CartdeckStages { unsigned budget; uint64_t count[CD_STAGE_COUNT]; } CartdeckStages;
+extern CartdeckStages g_cartdeck_stages;
+/* Bounded work even if a device never completes the requested GPU samples. */
+static inline void cartdeck_stage_hit(enum CartdeckStage stage)
+{
+    unsigned left = __atomic_load_n(&g_cartdeck_stages.budget, __ATOMIC_RELAXED);
+    while (left && !__atomic_compare_exchange_n(&g_cartdeck_stages.budget, &left, left - 1,
+                                               0, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {}
+    if (left) __atomic_fetch_add(&g_cartdeck_stages.count[stage], 1, __ATOMIC_RELAXED);
+}
+static inline void cartdeck_stage_report(char *out, size_t size)
+{
+    uint64_t c[CD_STAGE_COUNT];
+    for (unsigned i = 0; i < CD_STAGE_COUNT; i++)
+        c[i] = __atomic_load_n(&g_cartdeck_stages.count[i], __ATOMIC_RELAXED);
+    snprintf(out, size, "kernel_calls=%llu fe_cmd=%llu fe_draw=%llu back_cmd=%llu "
+             "back_draw_dispatch=%llu display_write=%llu swap_reject=%llu vk_draw=%llu pb_method=%llu budget_left=%u",
+             (unsigned long long)c[0], (unsigned long long)c[1], (unsigned long long)c[2],
+             (unsigned long long)c[3], (unsigned long long)c[4], (unsigned long long)c[5],
+             (unsigned long long)c[6], (unsigned long long)c[7], (unsigned long long)c[8], __atomic_load_n(&g_cartdeck_stages.budget, __ATOMIC_RELAXED));
+}
+#endif
