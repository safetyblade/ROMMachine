+/* CARTDECK debug-only numerical samples; no captured images leave native memory. */
+#ifndef CARTDECK_PIXEL_PROBE_H
+#define CARTDECK_PIXEL_PROBE_H
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <inttypes.h>
+static inline void cartdeck_pixel_summary(const uint8_t *pixels, size_t count, char *out, size_t size)
+{
+    uint64_t hash = UINT64_C(14695981039346656037);
+    unsigned lo = 255, hi = 0, white = 0, black = 0, alo = 255, ahi = 0;
+    for (size_t i = 0; i < count; i++) {
+        const uint8_t *p = pixels + i * 4;
+        for (unsigned c = 0; c < 4; c++) { hash ^= p[c]; hash *= UINT64_C(1099511628211); }
+        for (unsigned c = 0; c < 3; c++) { if (p[c] < lo) lo = p[c]; if (p[c] > hi) hi = p[c]; }
+        white += p[0] >= 250 && p[1] >= 250 && p[2] >= 250;
+        black += p[0] <= 5 && p[1] <= 5 && p[2] <= 5;
+        if (p[3] < alo) alo = p[3];
+        if (p[3] > ahi) ahi = p[3];
+    }
+    snprintf(out, size, "n=%zu rgb=%u..%u white=%u black=%u alpha=%u..%u fnv=%016" PRIx64,
+             count, lo, hi, white, black, alo, ahi, hash);
+}
+#endif
