+static void probe_drop(PsFrame *f)
+{
+    if (f->probe_map) T.vkUnmapMemory(g_hvk.dev, f->probe_mem);
+    if (f->probe_buf) T.vkDestroyBuffer(g_hvk.dev, f->probe_buf, NULL);
+    if (f->probe_mem) T.vkFreeMemory(g_hvk.dev, f->probe_mem, NULL);
+    f->probe_map = NULL; f->probe_buf = VK_NULL_HANDLE; f->probe_mem = VK_NULL_HANDLE;
+    f->probe_pending = false;
+}
+static bool probe_buffer(PsFrame *f)
+{
+    VkBufferCreateInfo ci = { .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, .size = 512,
+                              .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT };
+    if (T.vkCreateBuffer(g_hvk.dev, &ci, NULL, &f->probe_buf) != VK_SUCCESS) return false;
+    VkMemoryRequirements mr;
+    T.vkGetBufferMemoryRequirements(g_hvk.dev, f->probe_buf, &mr);
+    int mt = hle_vk_memtype(mr.memoryTypeBits,
+        VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, 0);
+    VkMemoryAllocateInfo ai = { .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+                                .allocationSize = mr.size, .memoryTypeIndex = (uint32_t)mt };
+    if (mt < 0 || T.vkAllocateMemory(g_hvk.dev, &ai, NULL, &f->probe_mem) != VK_SUCCESS ||
+        T.vkBindBufferMemory(g_hvk.dev, f->probe_buf, f->probe_mem, 0) != VK_SUCCESS ||
+        T.vkMapMemory(g_hvk.dev, f->probe_mem, 0, 512, 0, (void **)&f->probe_map) != VK_SUCCESS) {
+        probe_drop(f);
+        return false;
+    }
+    return true;
+}
+static void probe_collect(PsFrame *f)
+{
+    /* Called only after the existing frame timeline wait succeeds. No added wait,
+     * and no command pool/buffer is freed while a GPU copy might still reference it. */
+    if (!f->probe_pending) return;
+    char guest[160], swap[160], line[640];
+    cartdeck_pixel_summary(f->probe_map, 64, guest, sizeof(guest));
+    cartdeck_pixel_summary(f->probe_map + 256, 64, swap, sizeof(swap));
+    snprintf(line, sizeof(line), "\nserial=%llu guest=%ux%u {%s} swap=%ux%u fmt=%u gamma_changed=%u gamma=%u..%u {%s}",
+             (unsigned long long)f->probe_serial, f->probe_w, f->probe_h, guest,
+             f->probe_sw, f->probe_sh, f->probe_fmt, f->probe_gamma_changed,
+             f->probe_gamma_low, f->probe_gamma_high, swap);
+    pthread_mutex_lock(&g_probe_lock);
+    size_t used = strlen(g_probe_report);
+    snprintf(g_probe_report + used, sizeof(g_probe_report) - used, "%s", line);
+    pthread_mutex_unlock(&g_probe_lock);
+    g_probe_done++;
+    probe_drop(f);
+}
