+            VK_PIPELINE_STAGE_2_TRANSFER_BIT, VK_ACCESS_2_TRANSFER_READ_BIT);
+    VkBufferImageCopy regions[64] = {0};
+    for (unsigned i = 0; i < 64; i++) {
+        regions[i].bufferOffset = offset + i * 4;
+        regions[i].imageSubresource = (VkImageSubresourceLayers){ VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+        regions[i].imageOffset = (VkOffset3D){ (int32_t)(((i % 8) * 2 + 1) * (uint64_t)w / 16),
+                                             (int32_t)(((i / 8) * 2 + 1) * (uint64_t)h / 16), 0 };
+        regions[i].imageExtent = (VkExtent3D){1, 1, 1};
+    }
+    T.vkCmdCopyImageToBuffer(cb, image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, f->probe_buf, 64, regions);
+    barrier(cb, image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, next,
+            VK_PIPELINE_STAGE_2_TRANSFER_BIT, VK_ACCESS_2_TRANSFER_READ_BIT,
+            next == VK_IMAGE_LAYOUT_PRESENT_SRC_KHR ? VK_PIPELINE_STAGE_2_NONE : VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+            next == VK_IMAGE_LAYOUT_PRESENT_SRC_KHR ? 0 : (VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT));
+}
