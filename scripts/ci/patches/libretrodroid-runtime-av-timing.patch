new file mode 100644
--- /dev/null
+++ b/libretrodroid/src/main/cpp/runtimeavtiming.h
@@ -0,0 +1,67 @@
+#pragma once
+
+#include <atomic>
+#include <cmath>
+#include <mutex>
+
+// The core's environment callback may originate from a worker. Transfer
+// timing to the render/run owner only; never restart audio on that callback.
+namespace libretrodroid {
+struct RuntimeAvRate {
+    double fps = 60.0;
+    double sampleRate = 44100.0;
+};
+
+class RuntimeAvTiming {
+public:
+    static bool valid(RuntimeAvRate r) {
+        return std::isfinite(r.fps) && r.fps >= 1.0 && r.fps <= 240.0 &&
+               std::isfinite(r.sampleRate) && r.sampleRate >= 8000.0 &&
+               r.sampleRate <= 192000.0;
+    }
+
+    void reset() {
+        std::lock_guard<std::mutex> lock(mutex);
+        armed = false;
+        pendingFlag.store(false);
+    }
+
+    // retro_get_system_av_info at load remains authoritative.
+    void arm(RuntimeAvRate rate) {
+        std::lock_guard<std::mutex> lock(mutex);
+        active = rate;
+        armed = valid(rate);
+        pendingFlag.store(false);
+    }
+
+    bool publish(RuntimeAvRate rate) {
+        if (!valid(rate)) return false;
+        std::lock_guard<std::mutex> lock(mutex);
+        // This bounded increment supports cadence changes at the existing
+        // nominal sample rate. A genuine format change requires a separately
+        // verified stream replacement; reject it instead of pretending support.
+        if (armed && std::abs(rate.sampleRate - active.sampleRate) > 0.5)
+            return false;
+        pending = rate;
+        pendingFlag.store(true);
+        return true;
+    }
+
+    bool take(RuntimeAvRate& result) {
+        if (!pendingFlag.load()) return false;
+        std::lock_guard<std::mutex> lock(mutex);
+        if (!pendingFlag.exchange(false) || !armed) return false;
+        if (std::abs(active.fps - pending.fps) <= 0.000001) return false;
+        active.fps = pending.fps;
+        result = active;
+        return true;
+    }
+
+private:
+    std::mutex mutex;
+    std::atomic<bool> pendingFlag{false};
+    bool armed = false;
+    RuntimeAvRate active;
+    RuntimeAvRate pending;
+};
+} // namespace libretrodroid
