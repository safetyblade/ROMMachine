+bool LibretroDroid::applyRuntimeAvTiming() {
+    RuntimeAvRate rate;
+    if (!fpsSync || !Environment::getInstance().runtimeAvTiming().take(rate)) return false;
+    auto replacement = std::make_unique<FPSSync>(rate.fps, screenRefreshRate);
+    const double stretch = replacement->getTimeStretchFactor();
+    if (audio && std::isfinite(stretch) && stretch > 0.0)
+        audio->setTimingScale(stretch / initialAudioStretch);
+    fpsSync = std::move(replacement);
+    return true;
+}
+
+void LibretroDroid::step() {
+    std::lock_guard<std::mutex> lock(coreLock);
+    applyRuntimeAvTiming();
 
