new file mode 100644
index 0000000..29838c3
--- /dev/null
+++ b/libretrodroid/src/main/cpp/coreframesignal.h
@@ -0,0 +1,20 @@
+#ifndef LIBRETRODROID_COREFRAMESIGNAL_H
+#define LIBRETRODROID_COREFRAMESIGNAL_H
+#include <atomic>
+#include <cstdint>
+namespace libretrodroid {
+// A core-supplied frame, not proof of meaningful pixels or display presentation.
+class CoreFrameSignal {
+public:
+    void reset() { frames.store(0, std::memory_order_relaxed); }
+    void record(const void *data, unsigned width, unsigned height) {
+        // nullptr means duplicate/unchanged frame in the libretro ABI.
+        // RETRO_HW_FRAME_BUFFER_VALID (-1) is a valid hardware frame.
+        if (data && width > 0 && height > 0) frames.fetch_add(1, std::memory_order_relaxed);
+    }
+    uint64_t count() const { return frames.load(std::memory_order_relaxed); }
+private:
+    std::atomic<uint64_t> frames{0};
+};
+}
+#endif
