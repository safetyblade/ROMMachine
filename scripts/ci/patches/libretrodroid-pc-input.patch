+void Input::pollPcInput() {
+    for (auto &pad : pads) {
+        pad.mouseX = pad.pendingX;
+        pad.mouseY = pad.pendingY;
+        pad.pendingX = pad.pendingY = 0;
+    }
+}
+
+void Input::clearPcInput(unsigned port) {
+    if (port >= 4) return;
+    auto &pad = pads[port];
+    pad.pcKeys.clear();
+    for (auto &button : pad.mouseButtons) button = false;
+    pad.mouseX = pad.mouseY = pad.pendingX = pad.pendingY = 0;
+}
