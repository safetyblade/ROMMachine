diff --git a/libretrodroid/src/main/cpp/hwcontextnegotiation.h b/libretrodroid/src/main/cpp/hwcontextnegotiation.h
new file mode 100644
index 0000000..817004f
--- /dev/null
+++ b/libretrodroid/src/main/cpp/hwcontextnegotiation.h
@@ -0,0 +1,16 @@
+#ifndef LIBRETRODROID_HWCONTEXTNEGOTIATION_H
+#define LIBRETRODROID_HWCONTEXTNEGOTIATION_H
+
+// A rejected high-version probe is not an error once a lower context is accepted.
+// The load boundary prevents one game's negotiation from poisoning the next load.
+class HwContextNegotiation {
+public:
+    void beginLoad() { rejected = false; }
+    void reject() { rejected = true; }
+    void accept() { rejected = false; }
+    bool wasRejected() const { return rejected; }
+private:
+    bool rejected = false;
+};
+
+#endif
