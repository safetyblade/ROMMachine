+/* Snapshot guest-owned thread/recent-call state only on the vCPU, while the
+ * existing explicit probe is armed. UI formatting reads atomic copies. */
+static void cartdeck_kernel_sample(NcKernel *k, unsigned ordinal)
+{
+    if (!__atomic_load_n(&g_cartdeck_stages.budget, __ATOMIC_RELAXED)) return;
+    if (ordinal < CD_KERNEL_ORDINALS)
+        __atomic_fetch_add(&g_cartdeck_stages.ordinal[ordinal], 1, __ATOMIC_RELAXED);
+    /* Histogram every entry, thread/recent snapshots once per 32 entries. */
+    if ((__atomic_load_n(&g_cartdeck_stages.count[CD_KERNEL_CALL], __ATOMIC_RELAXED) & 31u) != 1u) return;
+    __atomic_fetch_add(&g_cartdeck_stages.snapshot_seq, 1, __ATOMIC_SEQ_CST);
+    unsigned states[6] = {0}, wt = 0, wc = 0, wo = 0, timed = 0;
+    for (unsigned i = 0; i < k->threads_hi && i < NC_MAX_THREADS; i++) {
+        const NcThread *t = &k->threads[i];
+        if ((unsigned)t->state < 6) states[t->state]++;
+        if (!wt && t->state == NC_T_WAITING) {
+            wt = t->id; wc = t->wait.count;
+            wo = wc ? t->wait.objects[0] : 0;
+            timed = t->wait.deadline_ns != 0;
+        }
+    }
+    for (unsigned i = 0; i < 6; i++)
+        __atomic_store_n(&g_cartdeck_stages.states[i], states[i], __ATOMIC_RELAXED);
+    __atomic_store_n(&g_cartdeck_stages.current_thread, k->current ? k->current->id : 0, __ATOMIC_RELAXED);
+    __atomic_store_n(&g_cartdeck_stages.wait_thread, wt, __ATOMIC_RELAXED);
+    __atomic_store_n(&g_cartdeck_stages.wait_count, wc, __ATOMIC_RELAXED);
+    __atomic_store_n(&g_cartdeck_stages.wait_object, wo, __ATOMIC_RELAXED);
+    __atomic_store_n(&g_cartdeck_stages.wait_timed, timed, __ATOMIC_RELAXED);
+    /* Reuse the existing recent-export ring, including the pre-probe wait.
+     * No arguments, strings, paths or guest memory are copied. */
+    unsigned end = g_nrecent;
+    for (unsigned n = 0; n < CD_RECENT_CALLS; n++) {
+        CartdeckCall *d = &g_cartdeck_stages.recent[n];
+        unsigned ordinal = 0, thread = 0, ret = 0, result = 0, running = 0;
+        if (n < end) {
+            unsigned i = (end - 1 - n) % RECENT;
+            ordinal = g_recent[i].ordinal; thread = g_recent[i].thread;
+            ret = g_recent[i].ret; result = g_recent[i].result; running = g_recent[i].running;
+        }
+        __atomic_store_n(&d->ordinal, ordinal, __ATOMIC_RELAXED);
+        __atomic_store_n(&d->thread, thread, __ATOMIC_RELAXED);
+        __atomic_store_n(&d->caller, ret, __ATOMIC_RELAXED);
+        __atomic_store_n(&d->result, result, __ATOMIC_RELAXED);
+        __atomic_store_n(&d->running, running, __ATOMIC_RELAXED);
+    }
+    __atomic_fetch_add(&g_cartdeck_stages.snapshot_seq, 1, __ATOMIC_SEQ_CST);
+}
+
+static const char *cartdeck_ordinal_name(unsigned ordinal)
+{
+    switch (ordinal) {
+    case NC_KORDINAL_DPC_RETURN: return "DPC_RETURN";
+    case NC_KORDINAL_ISR_RETURN: return "ISR_RETURN";
+    case NC_KORDINAL_APC_RETURN: return "APC_RETURN";
+    case NC_KORDINAL_CALLOUT_RETURN: return "CALLOUT_RETURN";
+    case NC_KORDINAL_THREAD_RETURN: return "THREAD_RETURN";
+    case NC_KORDINAL_APU_SPIN: return "APU_SPIN";
+    case NC_KORDINAL_TRAP: return "TRAP";
+    case NC_KORDINAL_SEH_RETURN: return "SEH_RETURN";
+    case NC_KORDINAL_SEH_NESTED: return "SEH_NESTED";
+    case NC_KORDINAL_SEH_COLLIDED: return "SEH_COLLIDED";
+    default: {
+        const NcKExport *e = nc_kernel_export(ordinal);
+        return e ? e->name : "unknown";
+    }
+    }
+}
+
+void nc_cartdeck_kernel_report(char *out, size_t size)
+{
+    unsigned begin = __atomic_load_n(&g_cartdeck_stages.snapshot_seq, __ATOMIC_SEQ_CST);
+    unsigned best[4] = {0};
+    uint64_t counts[4] = {0};
+    for (unsigned o = 0; o < CD_KERNEL_ORDINALS; o++) {
+        uint64_t n = __atomic_load_n(&g_cartdeck_stages.ordinal[o], __ATOMIC_RELAXED);
+        for (unsigned j = 0; j < 4; j++) if (n > counts[j]) {
+            for (unsigned k = 3; k > j; k--) { counts[k] = counts[k-1]; best[k] = best[k-1]; }
+            counts[j] = n; best[j] = o; break;
+        }
+    }
+    char top[320] = "", recent[400] = "";
+    size_t used = 0;
+    for (unsigned i = 0; i < 4 && used < sizeof(top); i++) if (counts[i])
+        used += (size_t)snprintf(top + used, sizeof(top) - used, "%s%s(%u):%llu",
+                                i ? "," : "", cartdeck_ordinal_name(best[i]), best[i],
+                                (unsigned long long)counts[i]);
+    used = 0;
+    for (unsigned i = 0; i < CD_RECENT_CALLS && used < sizeof(recent); i++) {
+        const CartdeckCall *c = &g_cartdeck_stages.recent[i];
+        unsigned o = __atomic_load_n(&c->ordinal, __ATOMIC_RELAXED);
+        if (!o) continue;
+        char result[16];
+        if (__atomic_load_n(&c->running, __ATOMIC_RELAXED)) snprintf(result, sizeof(result), "running");
+        else snprintf(result, sizeof(result), "%08x", __atomic_load_n(&c->result, __ATOMIC_RELAXED));
+        used += (size_t)snprintf(recent + used, sizeof(recent) - used, "%st%u:%s@%08x=%s",
+                                used ? "," : "", __atomic_load_n(&c->thread, __ATOMIC_RELAXED),
+                                cartdeck_ordinal_name(o), __atomic_load_n(&c->caller, __ATOMIC_RELAXED), result);
+    }
+    unsigned states[6];
+    for (unsigned i = 0; i < 6; i++) states[i] = __atomic_load_n(&g_cartdeck_stages.states[i], __ATOMIC_RELAXED);
+    unsigned current = __atomic_load_n(&g_cartdeck_stages.current_thread, __ATOMIC_RELAXED);
+    unsigned wt = __atomic_load_n(&g_cartdeck_stages.wait_thread, __ATOMIC_RELAXED);
+    unsigned wc = __atomic_load_n(&g_cartdeck_stages.wait_count, __ATOMIC_RELAXED);
+    unsigned wo = __atomic_load_n(&g_cartdeck_stages.wait_object, __ATOMIC_RELAXED);
+    unsigned timed = __atomic_load_n(&g_cartdeck_stages.wait_timed, __ATOMIC_RELAXED);
+    unsigned end = __atomic_load_n(&g_cartdeck_stages.snapshot_seq, __ATOMIC_SEQ_CST);
+    unsigned consistent = begin && !(begin & 1u) && begin == end;
+    snprintf(out, size, "kernel_top={%s} threads_at_kcall={snapshot_consistent=%u current=%u ready=%u running=%u "
+             "waiting=%u suspended=%u terminated=%u wait0=t%u objects=%u first=%08x timed=%u} recent_exports={%s}",
+             top, consistent, current, states[NC_T_READY], states[NC_T_RUNNING], states[NC_T_WAITING],
+             states[NC_T_SUSPENDED], states[NC_T_TERMINATED], wt, wc, wo, timed, recent);
+}
+
