+/* Channel and direct CACHE1 writes publish through the same ordering.
+ * The scout sees a new PUT before the decoder can, then the register is
+ * released before its wake. GET resets the scout only after publication. */
+static void fifo_dma_write(uint32_t off, uint32_t value)
+{
+    if (off == NV_PFIFO_CACHE1_DMA_PUT) hle_pb_pushed(value);
+    __atomic_store_n(reg(off), value, __ATOMIC_RELEASE);
+    if (off == NV_PFIFO_CACHE1_DMA_PUT) {
+        cartdeck_stage_hit(CD_FIFO_PUT);
+        hle_pb_put();
+    } else if (off == NV_PFIFO_CACHE1_DMA_GET) {
+        cartdeck_stage_hit(CD_FIFO_GET);
+        hle_pb_get();
+    }
+}
