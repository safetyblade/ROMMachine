+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <GLES3/gl3.h>
+#include <EGL/egl.h>
+#include <vector>
+#include <array>
+
+namespace libretrodroid {
+// A Libretro hardware core owns the current GL state at a video callback.
+// Presentation must neither interpret host-memory pointers as core VBO offsets
+// nor leave the core's cached GL state different from the actual driver state.
+class FrontendGLState {
+public:
+    explicit FrontendGLState(bool es3, bool preserve = true) : es3(es3), preserve(preserve) {
+        if (!preserve) return;
+        glGetIntegerv(GL_CURRENT_PROGRAM, &program);
+        glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &arrayBuffer);
+        glGetIntegerv(GL_RENDERBUFFER_BINDING, &renderbuffer);
+        glGetIntegerv(GL_VIEWPORT, viewport);
+        glGetFloatv(GL_COLOR_CLEAR_VALUE, clearColor);
+        glGetBooleanv(GL_COLOR_WRITEMASK, colorMask);
+        glGetIntegerv(GL_ACTIVE_TEXTURE, &activeTexture);
+        glGetIntegerv(GL_UNPACK_ALIGNMENT, &unpackAlignment);
+        if (es3) {
+            glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vao);
+            glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &drawFramebuffer);
+            glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &readFramebuffer);
+            glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &pixelUnpackBuffer);
+            glGetIntegerv(GL_UNPACK_ROW_LENGTH, &unpackRowLength);
+        } else {
+            glGetIntegerv(GL_FRAMEBUFFER_BINDING, &drawFramebuffer);
+            GLint count = 0;
+            glGetIntegerv(GL_MAX_VERTEX_ATTRIBS, &count);
+            attributes.resize(count);
+            for (GLuint i = 0; i < attributes.size(); ++i) {
+                auto& a = attributes[i];
+                glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_ENABLED, &a.enabled);
+                glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_SIZE, &a.size);
+                glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_STRIDE, &a.stride);
+                glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_TYPE, &a.type);
+                glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_NORMALIZED, &a.normalized);
+                glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_BUFFER_BINDING, &a.buffer);
+                glGetVertexAttribPointerv(i, GL_VERTEX_ATTRIB_ARRAY_POINTER, &a.pointer);
+            }
+        }
+        for (int i = 0; i < 2; ++i) {
+            glActiveTexture(GL_TEXTURE0 + i);
+            glGetIntegerv(GL_TEXTURE_BINDING_2D, &textures[i]);
+            if (es3) glGetIntegerv(GL_SAMPLER_BINDING, &samplers[i]);
+        }
+        glActiveTexture(activeTexture);
+        for (unsigned i = 0; i < capabilities.size(); ++i)
+            enabled[i] = glIsEnabled(capabilities[i]);
+        if (es3) rasterizerDiscard = glIsEnabled(GL_RASTERIZER_DISCARD);
+    }
+
+    void prepare() const {
+        for (auto capability : capabilities) glDisable(capability);
+        if (es3) {
+            glDisable(GL_RASTERIZER_DISCARD);
+            glBindSampler(0, 0);
+            glBindSampler(1, 0);
+            glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+            glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+        }
+        glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+        glActiveTexture(GL_TEXTURE0);
+    }
+
+    void replaceFramebuffer(GLuint previous, GLuint replacement) {
+        if (previous == 0 || previous == replacement) return;
+        if (drawFramebuffer == static_cast<GLint>(previous)) drawFramebuffer = replacement;
+        if (readFramebuffer == static_cast<GLint>(previous)) readFramebuffer = replacement;
+    }
+
+    ~FrontendGLState() {
+        if (!preserve) return;
+        if (es3) {
+            glBindVertexArray(vao);
+            glBindFramebuffer(GL_DRAW_FRAMEBUFFER, drawFramebuffer);
+            glBindFramebuffer(GL_READ_FRAMEBUFFER, readFramebuffer);
+            glBindBuffer(GL_PIXEL_UNPACK_BUFFER, pixelUnpackBuffer);
+            glPixelStorei(GL_UNPACK_ROW_LENGTH, unpackRowLength);
+            restore(GL_RASTERIZER_DISCARD, rasterizerDiscard);
+        } else {
+            glBindFramebuffer(GL_FRAMEBUFFER, drawFramebuffer);
+            for (GLuint i = 0; i < attributes.size(); ++i) {
+                const auto& a = attributes[i];
+                glBindBuffer(GL_ARRAY_BUFFER, a.buffer);
+                glVertexAttribPointer(i, a.size, a.type, a.normalized, a.stride, a.pointer);
+                if (a.enabled) glEnableVertexAttribArray(i); else glDisableVertexAttribArray(i);
+            }
+        }
+        glBindBuffer(GL_ARRAY_BUFFER, arrayBuffer);
+        glBindRenderbuffer(GL_RENDERBUFFER, renderbuffer);
+        glPixelStorei(GL_UNPACK_ALIGNMENT, unpackAlignment);
+        for (int i = 0; i < 2; ++i) {
+            glActiveTexture(GL_TEXTURE0 + i);
+            glBindTexture(GL_TEXTURE_2D, textures[i]);
+            if (es3) glBindSampler(i, samplers[i]);
+        }
+        glActiveTexture(activeTexture);
+        glUseProgram(program);
+        glViewport(viewport[0], viewport[1], viewport[2], viewport[3]);
+        glClearColor(clearColor[0], clearColor[1], clearColor[2], clearColor[3]);
+        glColorMask(colorMask[0], colorMask[1], colorMask[2], colorMask[3]);
+        for (unsigned i = 0; i < capabilities.size(); ++i)
+            restore(capabilities[i], enabled[i]);
+    }
+
+private:
+    static void restore(GLenum capability, GLboolean value) {
+        if (value) glEnable(capability); else glDisable(capability);
+    }
+    struct Attribute {
+        GLint enabled = 0, size = 4, stride = 0, type = GL_FLOAT, normalized = 0, buffer = 0;
+        void* pointer = nullptr;
+    };
+    const bool es3;
+    const bool preserve;
+    const std::array<GLenum, 7> capabilities = {GL_DEPTH_TEST, GL_BLEND, GL_SCISSOR_TEST,
+        GL_CULL_FACE, GL_STENCIL_TEST, GL_POLYGON_OFFSET_FILL, GL_SAMPLE_ALPHA_TO_COVERAGE};
+    GLboolean enabled[7]{}, rasterizerDiscard = GL_FALSE, colorMask[4]{};
+    GLint program = 0, arrayBuffer = 0, renderbuffer = 0, vao = 0;
+    GLint drawFramebuffer = 0, readFramebuffer = 0, pixelUnpackBuffer = 0;
+    GLint activeTexture = GL_TEXTURE0, textures[2]{}, samplers[2]{};
+    GLint viewport[4]{}, unpackAlignment = 4, unpackRowLength = 0;
+    GLfloat clearColor[4]{};
+    std::vector<Attribute> attributes;
+};
+
+// VAO state belongs to the frontend, not the core. GLES2 uses a VBO too; its
+// attribute state is restored by FrontendGLState instead of a VAO.
+class FrontendVertices {
+public:
+    ~FrontendVertices() {
+        if (context != EGL_NO_CONTEXT && context == eglGetCurrentContext()) {
+            if (vao) glDeleteVertexArrays(1, &vao);
+            if (buffer) glDeleteBuffers(1, &buffer);
+        }
+    }
+    void bind(bool es3, GLint position, GLint coordinate,
+              const float* vertices, const float* coordinates, unsigned count) {
+        const EGLContext current = eglGetCurrentContext();
+        if (context != current) {
+            // GL object names from a lost context must not delete objects in its replacement.
+            buffer = vao = 0;
+            context = current;
+        }
+        if (!buffer) glGenBuffers(1, &buffer);
+        if (es3) {
+            if (!vao) glGenVertexArrays(1, &vao);
+            glBindVertexArray(vao);
+        }
+        glBindBuffer(GL_ARRAY_BUFFER, buffer);
+        const GLsizeiptr bytes = count * sizeof(float);
+        glBufferData(GL_ARRAY_BUFFER, bytes * 2, nullptr, GL_STREAM_DRAW);
+        glBufferSubData(GL_ARRAY_BUFFER, 0, bytes, vertices);
+        glBufferSubData(GL_ARRAY_BUFFER, bytes, bytes, coordinates);
+        if (position >= 0) {
+            glVertexAttribPointer(position, 2, GL_FLOAT, GL_FALSE, 0, nullptr);
+            glEnableVertexAttribArray(position);
+        }
+        if (coordinate >= 0) {
+            glVertexAttribPointer(coordinate, 2, GL_FLOAT, GL_FALSE, 0, reinterpret_cast<void*>(bytes));
+            glEnableVertexAttribArray(coordinate);
+        }
+    }
+private:
+    EGLContext context = EGL_NO_CONTEXT;
+    GLuint buffer = 0, vao = 0;
+};
+}
