+bool Environment::currentContextSupports(unsigned requiredMajor, unsigned requiredMinor) const {
+    const char* version = reinterpret_cast<const char*>(glGetString(GL_VERSION));
+    unsigned major = 0;
+    unsigned minor = 0;
+    if (version == nullptr || std::sscanf(version, "OpenGL ES %u.%u", &major, &minor) != 2) {
+        LOGE("CARTDECK cannot verify current GLES context");
+        return false;
+    }
+    LOGI("CARTDECK GLES context actual=%u.%u required=%u.%u", major, minor, requiredMajor, requiredMinor);
+    return major > requiredMajor || (major == requiredMajor && minor >= requiredMinor);
+}
+
+bool Environment::isCurrentHwContextCompatible() const {
+    return !useHWAcceleration ||
+        (eglGetCurrentContext() != EGL_NO_CONTEXT && currentContextSupports(3, 0) &&
+         currentContextSupports(requiredGlesMajor, requiredGlesMinor));
+}
+
 bool Environment::environment_handle_set_hw_render(struct retro_hw_render_callback* hw_render_callback) {
+    if (hw_render_callback == nullptr) return false;
+    unsigned requiredMajor = 0;
+    unsigned requiredMinor = 0;
+    switch (hw_render_callback->context_type) {
+        case RETRO_HW_CONTEXT_OPENGLES2: requiredMajor = 2; break;
+        case RETRO_HW_CONTEXT_OPENGLES3: requiredMajor = 3; break;
+        case RETRO_HW_CONTEXT_OPENGLES_VERSION:
+            requiredMajor = hw_render_callback->version_major;
+            requiredMinor = hw_render_callback->version_minor;
+            break;
+        default:
+            LOGE("CARTDECK rejected unsupported hardware context type %u", hw_render_callback->context_type);
+            return false;
+    }
+    // loadGame runs on GLRetroView's GL thread. Never promise a desktop GL,
+    // Vulkan or higher GLES context than the actual Android surface provides.
+    if (eglGetCurrentContext() == EGL_NO_CONTEXT || requiredMajor < 2 ||
+        !currentContextSupports(3, 0) || !currentContextSupports(requiredMajor, requiredMinor)) {
+        LOGE("CARTDECK rejected required GLES %u.%u context", requiredMajor, requiredMinor);
+        return false;
+    }
+    requiredGlesMajor = requiredMajor;
+    requiredGlesMinor = requiredMinor;
     useHWAcceleration = true;
     useDepth = hw_render_callback->depth;
     useStencil = hw_render_callback->stencil;
