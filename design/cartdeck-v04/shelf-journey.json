{
  "schema": "cartdeck.shelfJourney/1.0",
  "defaultLibraryPresentation": "sideways-spines",
  "sequence": [
    "spine-shelf",
    "cover-detail",
    "open-or-resume",
    "existing-game-launch"
  ],
  "back": [
    "cover-detail -> spine-shelf",
    "cover-edit -> cover-detail"
  ],
  "selectedGameDoesNotLaunchImmediately": true,
  "emptyLibraryAction": "existing SAF folder-picker",
  "spine": {
    "asset": "../cartdeck-v05/cartridge/spine-base.svg",
    "title": "vertical render text",
    "systemBadge": true,
    "sort": [
      "recent",
      "alphabetical",
      "system",
      "manual"
    ],
    "focus": true,
    "brandMark": "../cartdeck-v03/brand/cslot-master.svg",
    "titleRendering": "runtime vertical/rotated text; no art baked in",
    "systemBadgeAsset": "../cartdeck-v05/cartridge/system-badge.svg"
  },
  "detail": {
    "asset": "../cartdeck-v05/cartridge/front-base.svg",
    "customCover": "existing CustomCoverManager integration",
    "placeholder": "../cartdeck-v05/cartridge/fallback-atlas.svg",
    "primaryAction": "Open",
    "secondary": "Resume when available",
    "tertiary": "Customize Cover",
    "metadata": [
      "title",
      "system",
      "last played"
    ],
    "saveMetadataSeparate": true,
    "chromeOverlay": "../cartdeck-v05/cartridge/front-overlay.svg",
    "systemBadgeAsset": "../cartdeck-v05/cartridge/system-badge.svg",
    "geometry": "cartdeck-v05/cartridge-family.json artWindow"
  },
  "coverEditor": {
    "sourceTypes": [
      "licensed local image",
      "original CARTDECK fallback"
    ],
    "options": [
      "crop",
      "zoom",
      "position",
      "display title",
      "system label",
      "reset"
    ],
    "mustNotAlterRomTitleOrDbGameId": true,
    "localOnly": true,
    "keepCopyrightedUserArtOutOfRepository": true
  },
  "transition": {
    "spineRotateOrSlide": "reduced motion alternative required",
    "nonblocking": true
  },
  "crossSystemFamily": "one front/spine geometry for GB GBC GBA and future systems; differences only metadata/badge/cover art"
}
