{
  "schema": "cartdeck.landscape-surround-design/1.0",
  "status": "design-only-not-runtime",
  "owner_decision_date": "2026-11-16",
  "source_spec": "../../../docs/design/GC01H_LANDSCAPE_ASPECT_SURROUND_V1.md",
  "aspect": {
    "default_on_every_new_game_session": "AUTO",
    "choices": [
      "AUTO",
      "WIDESCREEN"
    ],
    "persistence": "session-only",
    "widescreen_requires": [
      "verified_backend_support",
      "verified_title_or_engine_output",
      "native_apply_acknowledgement"
    ],
    "widescreen_never_automatically": [
      "stretches_4_3",
      "crops_gameplay",
      "enables_unreviewed_patches",
      "writes_save_data"
    ],
    "fallback_on_error": "AUTO",
    "diagnostic_status_if_no_native_aspect": "UNVERIFIED"
  },
  "surround": {
    "default": "STANDARD",
    "choices": [
      "STANDARD",
      "ORNAMENTAL"
    ],
    "persistence": "appearance-only",
    "never_overdraws": [
      "game_video",
      "controls",
      "logo_seat",
      "tv_overscan"
    ],
    "standard": {
      "frame_target_dp": 10,
      "frame_minimum_dp": 7,
      "accent_rail_dp": 2,
      "accent_opacity_range": [
        0.55,
        0.7
      ],
      "glass_guard_physical_px": 1,
      "details": [
        "chamfered_chassis",
        "inner_glass_lip",
        "short_corner_return",
        "subtle_parallel_rail"
      ]
    },
    "ornamental": {
      "full_target_dp": 26,
      "medium_target_dp": 18,
      "compressed_target_dp": 12,
      "minimum_edge_rail_dp": 8,
      "max_symmetric_video_size_reduction_percent": 5,
      "details": [
        "step_milled_chassis",
        "inset_secondary_shoulder",
        "bezel_rail",
        "twin_gutter_rails",
        "c_slot_diagonal_mill",
        "optional_micro_fasteners"
      ],
      "layout_priority": [
        "reuse_existing_gutters",
        "bounded_symmetric_shrink_if_user_selected",
        "compressed_ornament_if_tight"
      ],
      "avoid": [
        "fake_buttons",
        "continuous_neon_outline",
        "uncleared_control_hit_areas",
        "logo_duplicate",
        "texture_network_request"
      ]
    },
    "smart_compact": {
      "safe_drawing_insets": true,
      "tv_overscan_minimum_dp": 32,
      "touch_hit_target_minimum_dp": 48,
      "shell_draws_outside_video": true,
      "keep_one_pixel_inward_guard": true,
      "dualscreen_touch_unchanged": true
    }
  },
  "appearances": {
    "original": {
      "source": "design/cartdeck-v03/editions/original.json",
      "chassis": "#303B49",
