    "edgeHighlight": "Fine decorative machined line",
    "shelfShadow": "Soft shelf depth/shadow",
    "sectionDivider": "Section separators",
    "vacantCell": "Reserved, deliberately unoccupied slot",
    "sectionText": "Labels and captions on backboard",
    "focusOutline": "Keyboard focus, drag destination or empty-slot border",
