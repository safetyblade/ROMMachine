  "nativeRendering": {
    "useComposeSemanticTokens": true,
    "deriveFromApprovedEdition": true,
    "doNotFlattenShelfIntoSingleBitmap": true,
    "noUserCoverArtTint": true,
    "noGameViewportChanges": true,
    "visualDepth": "Subtle bevel, rail edge, inset shadow and restrained light; hardware not flat cards",
    "onCustomTheme": "Derive from selected chassis/bezel/secondary/accent, permit shelf overrides with contrast tests and persist outside ROM/saves",
    "sameGeometryAcrossEditions": true,
    "doNotScaleCartridgeBodyWithFontScale": true,
    "selectionAndFocus": "High-contrast interactive strokes; never rely on the decorative edgeHighlight",
    "contrastTargets": {
      "sectionLabelToBackboard": 4.5,
      "focusToBackboard": 3,
      "focusToVacantCell": 3,
      "dragAccentToBackboard": 3
    },
    "reducedMotion": "No flicker; static finishes and clear focus",
    "touchTargetMinimumDp": 48
  },
