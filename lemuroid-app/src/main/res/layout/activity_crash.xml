<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cartdeck_launcher_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_margin="24dp"
            android:paddingVertical="8dp">

            <ImageView
                android:src="@drawable/cartdeck_wordmark_native"
                android:contentDescription="CARTDECK"
                android:layout_width="match_parent"
                android:layout_height="42dp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/cartdeck_brand_accent"
                android:textSize="22sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@android:color/white" />

            <Button
                android:layout_marginBottom="5dp"
                android:id="@+id/importPs2Bios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:text="Complete PS2 setup" />

            <Button
                android:layout_marginBottom="5dp"
                android:id="@+id/retryGame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="Try again" />

            <Button
                android:layout_marginBottom="5dp"
                android:id="@+id/tryOtherEngine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="Try Enhanced Compatibility" />

            <Button
                android:layout_marginBottom="5dp"
                android:id="@+id/copyReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Copy diagnostic report" />

            <Button
                android:layout_marginBottom="5dp"
                android:id="@+id/reportProblem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Report this problem" />

            <Button
                android:layout_marginBottom="5dp"
                android:id="@+id/advancedDiagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Advanced diagnostics" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/returnToShelf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="8dp"
        android:textColor="@color/cartdeck_launcher_background"
        android:backgroundTint="@color/cartdeck_brand_neon_cyan"
        android:text="Return to shelf" />

</LinearLayout>
