diff --git a/libretrodroid/src/main/cpp/cartdeck_av_timing.h b/libretrodroid/src/main/cpp/cartdeck_av_timing.h
new file mode 100644
--- /dev/null
+++ b/libretrodroid/src/main/cpp/cartdeck_av_timing.h
@@ -0,0 +1,121 @@
+#ifndef CARTDECK_AV_TIMING_H
+#define CARTDECK_AV_TIMING_H
+#include <algorithm>
+#include <cmath>
+#include <mutex>
+#include <atomic>
+#include <array>
+#include <chrono>
+#include <string>
+#include <cstdint>
+namespace cartdeck {
+struct AvTiming {
+    double fps = 0;
+    double sampleRate = 0;
+    bool valid() const {
+        return std::isfinite(fps) && fps >= 1.0 && fps <= 1000.0 &&
+               std::isfinite(sampleRate) && sampleRate >= 1000.0 && sampleRate <= 384000.0;
+    }
+    bool sameFps(const AvTiming& other) const {
+        return std::abs(fps - other.fps) < 0.00001;
+    }
+    bool sameRate(const AvTiming& other) const {
+        return std::abs(sampleRate - other.sampleRate) < 0.001;
+    }
+};
+class AvTimingMailbox {
+public:
+    bool publish(AvTiming timing) {
+        if (!timing.valid()) return false;
+        std::lock_guard<std::mutex> lock(mutex);
+        pending = timing;
+        available = true;
+        return true;
+    }
+    bool take(AvTiming& result) {
+        std::lock_guard<std::mutex> lock(mutex);
+        if (!available) return false;
+        result = pending;
+        available = false;
+        return true;
+    }
+    void clear() {
+        std::lock_guard<std::mutex> lock(mutex);
+        available = false;
+    }
+private:
+    std::mutex mutex;
+    AvTiming pending;
+    bool available = false;
+};
+// Engineering candidate: first 4096 retro_run calls, no image or input data.
+// Audio counters cover the same capture window (not Android hardware XRuns).
+class PerfCounters {
+public:
+    static PerfCounters& instance() { static PerfCounters value; return value; }
+    void reset(bool capture) {
+        enabled.store(false);
+        runs.store(0); video.store(0); duplicate.store(0);
+        audioWritten.store(0); audioDropped.store(0); audioMissing.store(0);
+        timingChanges.store(0); lastFpsMilli.store(0); lastRate.store(0);
+        for (auto& count : histogram) count.store(0);
+        enabled.store(capture);
+    }
+    bool shouldSample() const {
+        return enabled.load(std::memory_order_relaxed) && runs.load(std::memory_order_relaxed) < 4096;
+    }
+    void recordRun(int64_t micros) {
+        if (!shouldSample()) return;
+        constexpr int limits[] = {4000, 8000, 12000, 17000, 25000, 34000, 50000};
+        unsigned bucket = 0;
+        while (bucket < 7 && micros > limits[bucket]) ++bucket;
+        histogram[bucket].fetch_add(1, std::memory_order_relaxed);
+        runs.fetch_add(1, std::memory_order_relaxed);
+    }
+    void recordVideo(bool isDuplicate) {
+        if (shouldSample()) (isDuplicate ? duplicate : video).fetch_add(1, std::memory_order_relaxed);
+    }
+    void recordAudioWrite(uint64_t requested, uint64_t accepted) {
+        if (!shouldSample()) return;
+        audioWritten.fetch_add(accepted, std::memory_order_relaxed);
+        audioDropped.fetch_add(requested - std::min(requested, accepted), std::memory_order_relaxed);
+    }
+    void recordAudioRead(uint64_t requested, uint64_t received) {
+        if (shouldSample()) audioMissing.fetch_add(requested - std::min(requested, received), std::memory_order_relaxed);
+    }
+    void recordTiming(double fps, double rate) {
+        if (!shouldSample()) return;
+        timingChanges.fetch_add(1, std::memory_order_relaxed);
+        lastFpsMilli.store(static_cast<uint64_t>(std::round(fps * 1000)), std::memory_order_relaxed);
+        lastRate.store(static_cast<uint64_t>(std::round(rate)), std::memory_order_relaxed);
+    }
+    std::string report() const {
+        if (!enabled.load()) return "";
+        std::string result = "runs=" + std::to_string(runs.load()) +
+            ";video=" + std::to_string(video.load()) +
+            ";duplicates=" + std::to_string(duplicate.load()) +
+            ";fifo_written=" + std::to_string(audioWritten.load()) +
+            ";fifo_dropped=" + std::to_string(audioDropped.load()) +
+            ";fifo_missing=" + std::to_string(audioMissing.load()) +
+            ";av_changes=" + std::to_string(timingChanges.load()) +
+            ";last_fps_milli=" + std::to_string(lastFpsMilli.load()) +
+            ";last_sample_rate=" + std::to_string(lastRate.load()) + ";run_us_bins=";
+        for (unsigned i = 0; i < histogram.size(); ++i) {
+            if (i) result += ",";
+            result += std::to_string(histogram[i].load());
+        }
+        return result;
+    }
+private:
+    std::atomic<bool> enabled{false};
+    std::atomic<uint64_t> runs{0}, video{0}, duplicate{0}, audioWritten{0}, audioDropped{0}, audioMissing{0};
+    std::atomic<uint64_t> timingChanges{0}, lastFpsMilli{0}, lastRate{0};
+    std::array<std::atomic<uint64_t>, 8> histogram{};
+};
+// The FIFO and scratch allocation are measured in int16_t samples.
+inline int boundedStereoFrames(double requested, int sampleCapacity) {
+    if (!std::isfinite(requested) || requested <= 0 || sampleCapacity < 2) return 0;
+    return static_cast<int>(std::min(requested, static_cast<double>(sampleCapacity / 2)));
+}
+}
+#endif
