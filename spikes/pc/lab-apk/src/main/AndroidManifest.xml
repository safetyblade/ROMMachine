<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="CARTDECK PC Lab" android:allowBackup="false" android:usesCleartextTraffic="false">
        <activity android:name=".LabSessionActivity" android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden|keyboard|screenLayout|smallestScreenSize"/>
        <activity android:name=".LabActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
