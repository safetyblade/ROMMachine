{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prestwich.dev/schemas/cartmod-maker/v1/project.schema.json",
  "title": "CARTMOD Maker experimental project v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "name",
    "targets",
    "board",
    "variables",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "GBC",
          "GBA"
        ]
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "rows",
        "player"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[.#GC]{1,30}$"
          }
        },
        "player": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "variables": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "integer",
            "minimum": -9999,
            "maximum": 9999
          }
        ]
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "event",
          "tile",
          "conditions",
          "actions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "event": {
            "enum": [
              "enter",
              "interact"
            ]
          },
          "tile": {
            "enum": [
              ".",
              "G",
              "C"
            ]
          },
          "conditions": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "variable",
                "compare",
                "value"
              ],
              "properties": {
                "variable": {
                  "type": "string"
                },
                "compare": {
                  "enum": [
                    "eq",
                    "ne",
                    "gt",
                    "gte",
                    "lt",
                    "lte"
                  ]
                },
                "value": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "integer",
                      "minimum": -9999,
                      "maximum": 9999
                    }
                  ]
                }
              }
            }
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "variable",
                "value"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "set",
                    "add"
                  ]
                },
                "variable": {
                  "type": "string"
                },
                "value": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "integer",
                      "minimum": -9999,
                      "maximum": 9999
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "targets": {
            "contains": {
              "const": "GBC"
            }
          }
        }
      },
      "then": {
        "properties": {
          "board": {
            "properties": {
              "width": {
                "maximum": 20
              },
              "height": {
                "maximum": 18
              }
            }
          }
        }
      }
    }
  ]
}
